# ============================================================
# HyperVisorX – .gitignore
# ============================================================

# Virtual environment
venv/
.venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Environment variables (NEVER commit secrets)
.env
.env.*
!.env.example

# Application logs (generated at runtime, not source)
logs/
*.log

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Testing
.pytest_cache/
.coverage
htmlcov/

# mypy
.mypy_cache/

# ============================================================
# Virtual Machines / libvirt
# ============================================================

# VM disk images
*.qcow2
*.qcow
*.img

# HyperVisorX VM snapshots
Backend/snapshots/

# VM runtime/state files
*.sav
*.vmstate